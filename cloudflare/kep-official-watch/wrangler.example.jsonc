{
  // TEMPLATE ONLY: this file must not be used to deploy without explicit approval.
  // Independent from existing beta email verifier and private applicant-intake Workers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kep-official-change-watch",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": { "MONITOR_ENABLED": "false" },
  "d1_databases": [
    {
      "binding": "MONITOR_DB",
      "database_name": "kep-official-watch-metadata",
      "database_id": "REPLACE_WITH_NEW_ISOLATED_MONITOR_D1_ID",
      "migrations_dir": "migrations"
    }
  ]
}
