{
  // Independent WATCHDOG; stays OFF and undeployable until separate owner approval.
  // It shares only dedicated official-monitor metadata D1 (never applicant/OTP D1).
  "name": "kep-official-monitor-watchdog",
  "main": "src/watchdog.mjs",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": [] },
  "vars": {
    "MONITOR_WATCHDOG_ENABLED": "false",
    "MONITOR_STALE_HOURS": "4"
  },
  "d1_databases": [{
    "binding": "MONITOR_DB",
    "database_name": "kep-official-watch-metadata",
    "database_id": "REPLACE_WITH_SEPARATE_MONITOR_ONLY_D1_ID",
    "migrations_dir": "migrations"
  }]
}
