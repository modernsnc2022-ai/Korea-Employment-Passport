.go.kr/","rows":[["SLC","1 salinan tersimpan"],["Slip gaji","Bulan yang sama dengan transfer"],["Mutasi rekening","Transfer gaji dapat dicocokkan"],["Jam kerja","Catatan tanggal masuk/pulang dan lembur"]],"checks":["Tanggal dan periode harus saling cocok.","Jangan hanya menyimpan screenshot sementara jika bukti asli dapat disimpan.","Jangan unggah bukti sensitif ke beta ini."]}]}
