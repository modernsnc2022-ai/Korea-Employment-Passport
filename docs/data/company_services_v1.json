{
  "version": "1.0.0",
  "productScope": "Indonesia -> Korea E-9 Manufacturing",
  "community": {
    "status": "backend_required",
    "visibility": "members_only",
    "authEnforcement": "server_side",
    "kepIdIsAuthentication": false,
    "publicPagesMayContainPosts": false,
    "pseudonymousDisplay": true,
