{"version":"2026-10-02","source":{"law":"https://www.law.go.kr/lsBylInfoPLinkR.do?bylBrNo=00&bylCls=BF&bylNo=0006&lsNm=%EC%99%B8%EA%B5%AD%EC%9D%B8%EA%B7%BC%EB%A1%9C%EC%9E%90%EC%9D%98+%EA%B3%A0%EC%9A%A9+%EB%93%B1%EC%97%90+%EA%B4%80%ED%95%9C+%EB%B2%95%EB%A5%A0+%EC%8B%9C%ED%96%89%EA%B7%9C%EC%B9%99","eps":"https://eps.hrdkorea.or.kr/e9/user/employment/employment.do?method=employProcessCompany","minimumWage":"https://www.minimumwage.go.kr/index.jsp"},"minimumWage2026":{"hourly":10320,"daily8h":82560,"monthly209h":2156880},"fields":[{"id":"enterpriseName","label":"Nama perusahaan","required":true,"type":"text"},{"id":"enterpriseLocation","label":"Alamat perusahaan","required":true,"type":"text"},{"id":"workplace","label":"Tempat kerja","required":true,"type":"text"},{"id":"industry","label":"Industri","required":true,"type":"text"},{"id":"jobDescription","label":"Jenis/tugas pekerjaan","required":true,"type":"text"},{"id":"contractMonths","label":"Lama kontrak (bulan)","required":true,"type":"number"},{"id":"workStart","label":"Jam mulai kerja","required":true,"type":"time"},{"id":"workEnd","label":"Jam selesai kerja","required":true,"type":"time"},{"id":"breakMinutes","label":"Waktu istirahat per hari (menit)","required":true,"type":"number"},{"id":"holidays","label":"Hari libur / hari istirahat","required":true,"type":"text"},{"id":"monthlyWage","label":"Upah normal bulanan (KRW)","required":true,"type":"number"},{"id":"basePay","label":"Gaji pokok (KRW)","required":true,"type":"number"},{"id":"fixedAllowance","label":"Tunjangan tetap (KRW)","required":false,"type":"number"},{"id":"bonus","label":"Bonus (KRW)","required":false,"type":"number"},{"id":"payDate","label":"Tanggal pembayaran gaji","required":true,"type":"text"},{"id":"paymentMethod","label":"Cara pembayaran","required":true,"type":"select","options":["Transfer ke rekening pekerja","Tunai langsung","Lainnya"]},{"id":"roomProvided","label":"Akomodasi disediakan?","required":true,"type":"select","options":["Ya","Tidak"]},{"id":"roomCost","label":"Biaya akomodasi yang ditanggung pekerja (KRW)","required":false,"type":"number"},{"id":"mealsProvided","label":"Makan disediakan?","required":true,"type":"select","options":["Ya","Tidak"]},{"id":"mealCost","label":"Biaya makan yang ditanggung pekerja (KRW)","required":false,"type":"number"}],"notes":["Employers must use the standard labor contract in the EPS process.","The employer must not keep the employee's bankbook or seal.","Room and meal provision and employee-paid costs should be clear in the contract.","Overtime/night/holiday pay rules depend on applicable labor law and workplace size."]}