name = "kep-beta-intake"
main = "src/worker.js"
compatibility_date = "2026-10-07"
workers_dev = true

# Create this namespace first:
# npx wrangler kv namespace create KEP_BETA_APPLICATIONS
# Then replace REPLACE_WITH_KV_NAMESPACE_ID below.
[[kv_namespaces]]
binding = "KEP_BETA_APPLICATIONS"
id = "REPLACE_WITH_KV_NAMESPACE_ID"

[vars]
ALLOWED_ORIGINS = "https://modernsnc2022-ai.github.io"
RETENTION_DAYS = "90"
